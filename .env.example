# Chatbot AI (tab Teks UML). Isi lewat environment variable di server, bukan di kode frontend.
# Di Vercel: Project Settings > Environment Variables. Lokal: lihat perintah di README/panduan.

# Alamat endpoint OpenAI-compatible, termasuk /v1. Bawaan: 9Router di komputer yang sama.
AI_BASE_URL=http://localhost:20128/v1
# Key dari 9Router atau penyedia AI (boleh kosong kalau endpoint tidak meminta key)
AI_API_KEY=
# Nama model persis seperti yang dikenal endpoint (wajib)
AI_MODEL=

# Riwayat PRD (login Google + database). Tanpa ini aplikasi tetap jalan, hanya tanpa riwayat.
# Database: di Vercel tambahkan Neon dari tab Storage; DATABASE_URL terisi otomatis.
# Lokal boleh kosong: data disimpan di file api/.local.db.
DATABASE_URL=
# OAuth client (Web application) dari Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URIs: https://<domain-anda>/api/auth/google/callback
#                           http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kunci penanda tangan cookie login, minimal 32 karakter acak. Buat dengan:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Model PRD berbeda per tingkat keahlian (hanya dipakai kalau PRD_AI_MODEL diisi). Boleh dikosongkan.
# PRD_AI_BASE_URL=http://localhost:20128/v1
# PRD_AI_MODEL=nama-model-bawaan
# PRD_AI_MODEL_PEMULA=
# PRD_AI_MODEL_MENENGAH=
# PRD_AI_MODEL_PRO=
