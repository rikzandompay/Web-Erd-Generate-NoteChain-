# Chatbot AI (tab Teks UML). Isi lewat environment variable di server, bukan di kode frontend.
# Di Vercel: Project Settings > Environment Variables. Lokal: lihat perintah di README/panduan.

# Alamat endpoint OpenAI-compatible, termasuk /v1. Bawaan: 9Router di komputer yang sama.
AI_BASE_URL=http://localhost:20128/v1
# Key dari 9Router atau penyedia AI (boleh kosong kalau endpoint tidak meminta key)
AI_API_KEY=
# Nama model persis seperti yang dikenal endpoint (wajib)
AI_MODEL=
